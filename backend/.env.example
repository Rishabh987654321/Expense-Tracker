# ----- Server -----
NODE_ENV=development
PORT=4000

# ----- App URLs -----
# Public root host (no subdomain). Used for email links to /signup, /invite/:token, etc.
PUBLIC_APP_URL=http://app.localhost:5173
# Pattern used to build per-tenant URLs in emails. {slug} is replaced.
TENANT_APP_URL=http://{slug}.localhost:5173
# Reserved subdomains that are NOT treated as tenant slugs.
RESERVED_SUBDOMAINS=app,www,api

# ----- CORS -----
# Comma-separated list of allowed origin REGEX patterns.
CORS_ORIGIN_REGEX=^http:\/\/([a-z0-9-]+\.)?localhost:5173$

# ----- Database -----
# app_user: BYPASSRLS = false. Used by the running API.
DATABASE_URL=postgresql://app_user:app_user_pw@localhost:5432/expense_tracker?schema=public
# app_owner: BYPASSRLS = true / table owner. Used by `prisma migrate` and signup-org.
MIGRATE_DATABASE_URL=postgresql://app_owner:app_owner_pw@localhost:5432/expense_tracker?schema=public

# ----- Auth -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
INVITE_TTL_HOURS=72

# ----- Redis (BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Azure Blob -----
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=receipts
AZURE_SAS_TTL_MINUTES=15

# ----- SendGrid -----
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_email
SENDGRID_FROM_NAME=Expense Tracker
# When true, emails are logged to stdout instead of sent (handy for dev without a SendGrid key).
EMAIL_DRY_RUN=false
